{
  "name": "makerbench-next",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "env:codegen": "varlock codegen",
    "prebuild": "pnpm env:codegen",
    "build": "cross-env APP_ENV=test tsc -b && cross-env APP_ENV=test vite build",
    "build:ci": "pnpm build",
    "prebuild:production": "pnpm env:codegen",
    "build:production": "cross-env APP_ENV=production tsc -b && cross-env APP_ENV=production vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore",
    "preview": "vite preview",
    "test": "pnpm test:unit && pnpm test:components",
    "test:unit": "cross-env APP_ENV=test vitest --run --project=unit",
    "test:components": "cross-env APP_ENV=test vitest --run --project=components",
    "test:coverage": "cross-env APP_ENV=test vitest --run --coverage --project unit --project components",
    "test:watch": "cross-env APP_ENV=test vitest",
    "test:storybook": "cross-env APP_ENV=test vitest --project storybook run",
    "test:e2e": "cross-env APP_ENV=test playwright test",
    "test:e2e:ui": "cross-env APP_ENV=test playwright test --ui",
    "test:e2e:headed": "cross-env APP_ENV=test playwright test --headed",
    "performance:capture": "node scripts/performance/capture.ts",
    "performance:baseline": "node scripts/performance/capture.ts --baseline=2026-07-26",
    "pretypecheck": "pnpm env:codegen",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.quality.json --noEmit && tsc -p tsconfig.functions.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs src netlify/functions scripts --output-type err",
    "check:unused": "cross-env APP_ENV=test knip --config knip.jsonc",
    "check:spelling": "cspell lint --config cspell.json --no-progress --gitignore --max-file-size 256KB \"README.md\" \"AGENTS.md\" \"GOAL.md\" \"ROADMAP.md\" \"architecture.md\" \"DATABASE_SETUP.md\" \"docs/**/*.md\" \".github/**/*.{md,yml,yaml}\" \"src/components/**/*.{ts,tsx,css}\" \"src/pages/**/*.{ts,tsx,css}\" \"src/styles/**/*.css\" --exclude \"**/__tests__/**\" --exclude \"**/*.stories.tsx\"",
    "check:actions": "node scripts/quality/check-actions.ts",
    "check:coverage-floor": "node scripts/quality/check-coverage-thresholds.ts",
    "check:coverage": "pnpm test:coverage && pnpm check:coverage-floor",
    "performance:budget": "size-limit",
    "check:fast": "pnpm format:check && pnpm lint && pnpm lint:css && pnpm typecheck && pnpm test && pnpm check:architecture && pnpm check:unused && pnpm check:spelling && pnpm check:actions",
    "check:pr": "pnpm check:fast && pnpm check:coverage && pnpm build && pnpm performance:budget && pnpm test:storybook && pnpm test:e2e --project=chromium",
    "check:ci": "pnpm check:pr",
    "quality": "pnpm check:fast && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "migrate:makerbench-turso": "tsx scripts/import-makerbench-turso.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "cross-env APP_ENV=test storybook build"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@netlify/functions": "^5.3.0",
    "@sentry/node": "^10.59.0",
    "@supabase/supabase-js": "^2.110.1",
    "@varlock/1password-plugin": "^1.2.0",
    "cheerio": "^1.1.2",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.15.1",
    "undici": "^7.22.0",
    "valibot": "^1.4.2",
    "varlock": "^1.8.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@electric-sql/pglite": "^0.5.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@size-limit/file": "13.0.1",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.13.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@varlock/vite-integration": "^1.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "10.1.0",
    "cspell": "10.1.1",
    "dependency-cruiser": "18.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-storybook": "10.5.10",
    "fflate": "^0.8.3",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.6",
    "knip": "6.33.0",
    "msw": "^2.14.7",
    "msw-storybook-addon": "^2.0.7",
    "playwright": "^1.60.0",
    "prettier": "^3.9.5",
    "size-limit": "13.0.1",
    "storybook": "10.5.10",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "tar": "7.5.22",
    "tsx": "4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "24.20.0"
  },
  "packageManager": "pnpm@11.10.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
